<Window x:Class="PCConnect.Windows.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PCConnect" Height="900" Width="720" MinHeight="620" MinWidth="620"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="InkBrush" Color="#111827" />
    <SolidColorBrush x:Key="MutedBrush" Color="#536175" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#E3E8F0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />

    <Style x:Key="FieldLabel" TargetType="Label">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,0,7" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style x:Key="FieldShell" TargetType="Border">
      <Setter Property="Height" Value="46" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#BCC7D6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="#8291A6" />
        </Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
          <Setter Property="BorderThickness" Value="2" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#F1F4F8" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="22,9" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="{StaticResource AccentPressedBrush}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#93C5FD" />
                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="3" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#9AA9BD" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="#1E3A8A" />
      <Setter Property="Background" Value="#EAF2FF" />
      <Setter Property="BorderBrush" Value="#BED5FF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#DCEAFF" />
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#93BAFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonSurface" Property="Background" Value="#C9DEFF" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#2563EB" />
                <Setter TargetName="ButtonSurface" Property="BorderThickness" Value="3" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Padding="30,24">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#111C44" Offset="0" />
          <GradientStop Color="#1E3A8A" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="50" Height="50" CornerRadius="14" Background="#3B82F6" Margin="0,0,16,0">
          <TextBlock Text="PC" Foreground="White" FontWeight="Bold" FontSize="18"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="PCConnect" Foreground="White" FontWeight="SemiBold" FontSize="24" />
          <TextBlock Text="Secure access for this Windows PC" Foreground="#C7D8FF" FontSize="13" />
        </StackPanel>
        <Border Grid.Column="2" VerticalAlignment="Center" Background="#26FFFFFF" CornerRadius="12" Padding="11,6">
          <TextBlock Text="SECURE SETUP" Foreground="#EAF2FF" FontSize="10" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="30,24">
      <Border MaxWidth="700" Background="White" BorderBrush="{StaticResource SubtleBrush}"
              BorderThickness="1" CornerRadius="14" Padding="30">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <Grid Margin="0,0,8,0">
            <StackPanel x:Name="WaitingPanel" AutomationProperties.LiveSetting="Polite">
              <TextBlock Text="Preparing PCConnect" FontSize="23" FontWeight="SemiBold"
                         Foreground="{StaticResource InkBrush}" />
              <TextBlock Margin="0,10,0,22" Text="Connecting to the protected Windows service on this PC."
                         FontSize="15" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
              <ProgressBar Height="5" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>

            <StackPanel x:Name="LoginPanel" Visibility="Collapsed">
              <TextBlock x:Name="EnrollmentTitle" Text="Connect this PC" FontSize="24" FontWeight="SemiBold"
                         Foreground="{StaticResource InkBrush}" />
              <TextBlock x:Name="EnrollmentDescription" Margin="0,8,0,20" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="14"
                         Text="Sign in once. PCConnect will create a protected device identity and link it to your account." />

              <Border x:Name="EnrollmentSteps" Background="#F7F9FC" BorderBrush="{StaticResource SubtleBrush}" BorderThickness="1"
                      CornerRadius="9" Padding="14,11" Margin="0,0,0,20">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="AccountStepBadge" Width="22" Height="22" CornerRadius="11" Background="#DBEAFE">
                    <TextBlock x:Name="AccountStepNumber" Text="1" Foreground="#1D4ED8" FontWeight="Bold" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock x:Name="AccountStepText" Grid.Column="1" Text="Account" Margin="7,0,14,0" VerticalAlignment="Center"
                             Foreground="#334155" FontSize="12" FontWeight="SemiBold" />
                  <Border x:Name="DeviceStepBadge" Grid.Column="2" Width="22" Height="22" CornerRadius="11" Background="#E8ECF2">
                    <TextBlock x:Name="DeviceStepNumber" Text="2" Foreground="#526175" FontWeight="Bold" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock x:Name="DeviceStepText" Grid.Column="3" Text="PC name" Margin="7,0,14,0" VerticalAlignment="Center"
                             Foreground="#526175" FontSize="12" FontWeight="SemiBold" />
                  <Border Grid.Column="4" Width="22" Height="22" CornerRadius="11" Background="#E8ECF2">
                    <TextBlock Text="3" Foreground="#526175" FontWeight="Bold" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="5" Text="Windows" Margin="7,0,0,0" VerticalAlignment="Center"
                             Foreground="#526175" FontSize="12" FontWeight="SemiBold" />
                </Grid>
              </Border>

              <Border x:Name="ErrorBanner" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FECACA"
                      BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,18"
                      AutomationProperties.LiveSetting="Assertive">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="22" Height="22" CornerRadius="11" Background="#DC2626" Margin="0,0,10,0">
                    <TextBlock Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                  </Border>
                  <TextBlock x:Name="ErrorText" Grid.Column="1" Foreground="#991B1B" TextWrapping="Wrap"
                             VerticalAlignment="Center" FontSize="13" />
                </Grid>
              </Border>

              <StackPanel x:Name="AccountStepPanel">
                <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=LoginInput}" Content="Username or email" />
                <Border x:Name="LoginField" Style="{StaticResource FieldShell}">
                  <TextBox x:Name="LoginInput" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                           Padding="11,0" FontSize="15" VerticalContentAlignment="Center" Foreground="{StaticResource InkBrush}"
                           AutomationProperties.Name="Username or email"
                           AutomationProperties.HelpText="Enter the username or email for your PCConnect account"
                           SpellCheck.IsEnabled="False" />
                </Border>

                <Label Style="{StaticResource FieldLabel}" Target="{Binding ElementName=PasswordInput}"
                       Content="Password" Margin="0,16,0,7" />
                <Border x:Name="PasswordField" Style="{StaticResource FieldShell}">
                  <PasswordBox x:Name="PasswordInput" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                               Padding="11,0" FontSize="15" VerticalContentAlignment="Center" Foreground="{StaticResource InkBrush}"
                               AutomationProperties.Name="Password"
                               AutomationProperties.HelpText="Enter your PCConnect account password" />
                </Border>
              </StackPanel>

              <StackPanel x:Name="DeviceNameStepPanel" Visibility="Collapsed">
                <Label x:Name="DeviceNameLabel" Style="{StaticResource FieldLabel}" Target="{Binding ElementName=DeviceNameInput}"
                       Content="PC name" />
                <Border x:Name="DeviceNameField" Style="{StaticResource FieldShell}">
                  <TextBox x:Name="DeviceNameInput" Style="{x:Null}" Background="Transparent" BorderThickness="0"
                           Padding="11,0" FontSize="15" VerticalContentAlignment="Center" Foreground="{StaticResource InkBrush}"
                           AutomationProperties.Name="PC name"
                           AutomationProperties.HelpText="Choose how this Windows PC appears in your PCConnect account" MaxLength="100" />
                </Border>
                <TextBlock Margin="0,9,0,0" Foreground="#68778A" FontSize="12" TextWrapping="Wrap"
                           Text="We’ve filled in your Windows PC name. You can change it to anything recognizable." />
              </StackPanel>

              <Border Background="#EFF6FF" BorderBrush="#D5E6FF" BorderThickness="1"
                      CornerRadius="8" Padding="12" Margin="0,17,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E"
                          VerticalAlignment="Center" Margin="0,0,10,0" />
                  <TextBlock x:Name="ServerText" Grid.Column="1" Foreground="#1E3A8A" FontSize="12"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <ProgressBar x:Name="BusyBar" Height="4" Margin="0,18,0,0" IsIndeterminate="True"
                           Foreground="{StaticResource AccentBrush}" Visibility="Collapsed" />
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Width="105" Margin="0,0,12,0" Style="{StaticResource SecondaryButton}"
                        Content="Back" Click="BackClick" Visibility="Collapsed" IsCancel="True"
                        AutomationProperties.HelpText="Return to the account sign-in step" />
                <Button x:Name="EnrollButton" Grid.Column="1" Style="{StaticResource PrimaryButton}"
                        Content="Sign in and continue" Click="EnrollClick" IsDefault="True"
                        AutomationProperties.HelpText="Sign in and continue to name this Windows PC" />
              </Grid>
              <TextBlock x:Name="PasswordPrivacyText" Margin="0,13,0,0" Foreground="#68778A" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                         Text="Your password is used only for sign-in and is never stored on this PC." />
            </StackPanel>

            <StackPanel x:Name="EnrolledPanel" Visibility="Collapsed" VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite">
              <Border Width="76" Height="76" CornerRadius="38" Background="#DCFCE7" HorizontalAlignment="Center">
                <Path Data="M 19,38 L 32,51 L 57,24" Stroke="#15803D" StrokeThickness="6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
              </Border>
              <TextBlock Text="This PC is connected" Margin="0,20,0,8" FontSize="25" FontWeight="SemiBold"
                         Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
              <TextBlock x:Name="EnrolledMessage" TextWrapping="Wrap" TextAlignment="Center"
                         Foreground="{StaticResource MutedBrush}" FontSize="15" MaxWidth="450" />
              <Border Background="#F7F9FC" BorderBrush="{StaticResource SubtleBrush}" BorderThickness="1"
                      CornerRadius="9" Padding="16,13" Margin="0,22,0,0">
                <StackPanel>
                  <TextBlock Text="DEVICE" Foreground="#718096" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock x:Name="ConnectedDeviceNameText" Margin="0,3,0,0" Foreground="{StaticResource InkBrush}"
                             FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
              <Button MinWidth="210" Margin="0,24,0,0" Style="{StaticResource SecondaryButton}"
                      Content="Run in background" Click="DismissClick" />
              <TextBlock Margin="0,12,0,0" Text="You can safely close this window. The secure service stays active."
                         Foreground="#68778A" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource SubtleBrush}"
            BorderThickness="0,1,0,0" Padding="30,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="4" Background="#64748B"
                VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Starting PCConnect…"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" />
      </Grid>
    </Border>
  </Grid>
</Window>
