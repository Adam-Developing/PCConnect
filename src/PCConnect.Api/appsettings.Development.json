{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },

  "Database": {
    // The throwaway dev container from the README. It sets POSTGRES_PASSWORD,
    // and the image defaults to scram-sha-256, so the password has to be here
    // or the API cannot connect while the migrator can.
    "ConnectionString": "Host=localhost;Port=15432;Database=pcconnect;Username=postgres;Password=postgres",
    "MigrateOnStartup": true
  },

  "Discovery": {
    "RealtimeUrl": "ws://localhost:5080/rt"
  },

  "Web": {
    "CorsAllowedOrigins": [ "http://localhost:5173" ]
  }
}
