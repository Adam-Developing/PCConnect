{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },

  "Database": {
    "ConnectionString": "",
    "MigrateOnStartup": false
  },

  "Cache": {
    "ConnectionString": ""
  },

  "Argon2": {
    "MemoryKib": 19456,
    "TimeCost": 2,
    "Parallelism": 1
  },

  "Jwt": {
    "Issuer": "https://api.pcconnect.local",
    "Audience": "pcconnect-api",
    "PrivateKeyPem": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "StepUpTokenSeconds": 300,
    "ClockSkewSeconds": 60
  },

  "Kek": {
    "CurrentKekId": "k1",
    "Keys": {}
  },

  "Identity": {
    "AcceptLegacyPasswordHash": true,
    "RequireVerifiedEmailToLogIn": false,
    "MaxFailedAttemptsBeforeLockout": 10,
    "PasswordResetTtlMinutes": 30
  },

  "WebAuthn": {
    "RelyingPartyId": "localhost",
    "RelyingPartyName": "PCConnect",
    "AllowedOrigins": [ "http://localhost:5173", "https://localhost:5173" ],
    "ChallengeTimeoutSeconds": 300
  },

  "Discovery": {
    "ApiVersion": "2.0.0",
    "RealtimeUrl": "wss://localhost:5001/rt",
    "MinimumSupportedClient": {
      "desktop": "5.0.0",
      "mobile": "8.0.0"
    },
    "RecommendedClient": {
      "desktop": "5.0.0",
      "mobile": "8.0.0"
    },
    "LegacySunsetAt": null
  },

  "Web": {
    "CorsAllowedOrigins": [],
    "EnableHsts": false,
    "EnableLegacyShim": true,
    "LegacyShimRetired": false
  },

  "AllowedHosts": "*"
}
