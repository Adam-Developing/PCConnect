**/obj
**/node_modules
**/.gradle
**/build
db/*.sql
db/dumps
DB/*.sql
.git
.github
.idea
.vs
clients/android
clients/windows
App
PCClient
api
tests
docs
deploy/env
**/.env
**/.env.*
**/*.jks
**/*.keystore
**/*.pfx
**/*.pem
