PCCONNECT_ENVIRONMENT=staging
PCCONNECT_RELEASE=replace-with-immutable-release-id
PCCONNECT_API_IMAGE=ghcr.io/replace-with-owner/pcconnect-api@sha256:replace-with-64-hex-digest
PCCONNECT_WORKER_IMAGE=ghcr.io/replace-with-owner/pcconnect-worker@sha256:replace-with-64-hex-digest
PCCONNECT_MIGRATOR_IMAGE=ghcr.io/replace-with-owner/pcconnect-migrator@sha256:replace-with-64-hex-digest
PCCONNECT_CADDY_IMAGE=caddy@sha256:replace-with-64-hex-digest
PCCONNECT_POSTGRES_IMAGE=postgres@sha256:replace-with-64-hex-digest
PCCONNECT_VALKEY_IMAGE=valkey/valkey@sha256:replace-with-64-hex-digest
PCCONNECT_OTEL_IMAGE=otel/opentelemetry-collector-contrib@sha256:replace-with-64-hex-digest
PCCONNECT_PROMETHEUS_IMAGE=prom/prometheus@sha256:replace-with-64-hex-digest
PCCONNECT_PUSHGATEWAY_IMAGE=prom/pushgateway@sha256:replace-with-64-hex-digest
PCCONNECT_NODE_EXPORTER_IMAGE=prom/node-exporter@sha256:replace-with-64-hex-digest
PCCONNECT_API_HOST=staging-api.example.invalid
PCCONNECT_WEB_ORIGIN=https://staging.example.invalid
PCCONNECT_WEBAUTHN_RP_ID=staging.example.invalid
PCCONNECT_ANDROID_PACKAGE_NAME=com.adamkhattab.pcconnect.debug
PCCONNECT_ANDROID_CERT_SHA256=AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA:AA
PCCONNECT_ANDROID_WEBAUTHN_ORIGIN=android:apk-key-hash:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Android build input; must equal PCCONNECT_WEBAUTHN_RP_ID for verified account links.
PCCONNECT_ANDROID_RP_HOST=staging.example.invalid
PCCONNECT_ACME_EMAIL=replace@example.invalid
PCCONNECT_ACTIVE_UPSTREAM=api-blue:8080
PCCONNECT_STATE_ROOT=/srv/pcconnect-v2/staging
PCCONNECT_SECRET_ROOT=/etc/pcconnect-v2/staging
PCCONNECT_BACKUP_ROOT=/srv/pcconnect-v2/staging-backup-staging
PCCONNECT_BACKUP_AGE_RECIPIENT=age1replacewithapprovedescrowrecipient
PCCONNECT_BACKUP_DESTINATION=replace-with-rclone-remote:pcconnect/staging
PCCONNECT_RESTORE_ROOT=/srv/pcconnect-v2/restore-rehearsals/replace-with-unique-rehearsal-id
PCCONNECT_AGE_IDENTITY_FILE=/etc/pcconnect-v2/escrow/age-identity.txt
# Set only after explicit approval when installing recurring production backup timers:
# PCCONNECT_PRODUCTION_BACKUP_APPROVED=I_HAVE_EXPLICIT_APPROVAL
