# =============================================================================
# PCConnect v2 — deployment configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed:
# S1-01 is exactly this file's predecessor, `api/db_config.php`, sitting
# untracked-but-not-ignored in a working tree with live credentials in it.
#
# Every generated value below is produced by `deploy/env/generate-secrets.sh`.
# Nothing here has a default that would work in production by accident.
# =============================================================================

# ── identity of the deployment ───────────────────────────────────────────────
PCCONNECT_DOMAIN=pcconnect.example
ACME_EMAIL=you@example.com

# ── database ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 33
POSTGRES_PASSWORD=

# ── token signing (03 §2.2) ──────────────────────────────────────────────────
# A P-256 private key in PEM. Generate:
#   openssl ecparam -name prime256v1 -genkey -noout -out jwt.pem
# then paste it here with literal \n between lines, or use
# `deploy/env/generate-secrets.sh`, which does the escaping.
JWT_PRIVATE_KEY_PEM=

# ── envelope encryption (ADR-0004) ───────────────────────────────────────────
# The key encryption key. It wraps every user's data key and is NEVER stored in
# the database — that separation is the whole point of the envelope.
#
# Losing this loses every reminder. It belongs in the password manager and in an
# offline copy, and its loss scenario is in the runbook.
#
# There are two slots because a rotation is not a flag day. The slot NAME is the
# id recorded in users.dek_kek_id, so a slot must never be refilled with a
# different key: doing so tells the server that rows wrapped with the old key
# were wrapped with the new one, and they stop decrypting.
#
# Rotating (runbook §5): put the new key in the empty slot, point
# KEK_CURRENT_ID at it, run `rewrap-deks`, and only then empty the old slot.
#
# Generate: openssl rand -base64 32
KEK_CURRENT_ID=k1
KEK_KEY_K1=
KEK_KEY_K2=

# ── backups (02 §9) ──────────────────────────────────────────────────────────
# The age *public* key. Safe to commit; the private key is offline.
# Generate: age-keygen -o backup-key.txt   (the file's public line goes here)
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30

# ── legacy sunset (ADR-0008) ─────────────────────────────────────────────────
# The shim stays on until the Prometheus counter says legacy traffic is under
# 1% for fourteen days — a measurement, not a date. These switch it off when
# that has happened.
ENABLE_LEGACY_SHIM=true
LEGACY_SHIM_RETIRED=false
# RFC 3339. Drives the `Sunset` header and `GET /v2/meta/discovery`.
LEGACY_SUNSET_AT=

# ── tuning ───────────────────────────────────────────────────────────────────
# Argon2id, at or above the OWASP floor. The API refuses to start below it.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2

# How often expired commands are swept. This is the delay between a command's
# TTL passing and the phone being told it was not delivered.
COMMAND_SWEEP_SECONDS=5

# ── images ───────────────────────────────────────────────────────────────────
# SHA-tagged in CI; `latest` only for a local build.
PCCONNECT_IMAGE_API=pcconnect/api:latest
PCCONNECT_IMAGE_WORKER=pcconnect/worker:latest
