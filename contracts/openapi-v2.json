{
  "openapi": "3.1.0",
  "info": {
    "title": "PCConnect API",
    "version": "2.0.0",
    "description": "Authoritative REST contract for PCConnect controllers and agents. SignalR notifications are advisory; REST resources are authoritative."
  },
  "servers": [
    { "url": "https://api.pcconnect.adamdeveloping.co.uk/api/v2", "description": "Production" }
  ],
  "tags": [
    { "name": "Operations" },
    { "name": "Identity" },
    { "name": "Account" },
    { "name": "Enrollment" },
    { "name": "Devices" },
    { "name": "Commands" },
    { "name": "Agent" },
    { "name": "Reminders" }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": ["Operations"], "operationId": "getLiveness", "security": [],
        "responses": { "200": { "description": "Process is alive", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } } }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["Operations"], "operationId": "getReadiness", "security": [],
        "responses": { "200": { "description": "Required dependencies are ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } } }, "503": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/version": {
      "get": {
        "tags": ["Operations"], "operationId": "getVersion", "security": [],
        "responses": { "200": { "description": "Public release versions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Version" } } } } }
      }
    },
    "/auth/password/login": {
      "post": {
        "tags": ["Identity"], "operationId": "passwordLogin", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordLoginRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/TokenPair" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Identity"], "operationId": "registerAccount", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RegistrationRequest" } } } },
        "responses": { "202": { "description": "Account created; email verification required" }, "400": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Identity"], "operationId": "refreshSession", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } } },
        "responses": { "200": { "$ref": "#/components/responses/TokenPair" }, "401": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Identity"], "operationId": "logout", "responses": { "204": { "description": "Session revoked" }, "401": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/password/change": {
      "post": {
        "tags": ["Identity"], "operationId": "changePassword", "parameters": [{ "$ref": "#/components/parameters/StepUpGrant" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordChangeRequest" } } } },
        "responses": { "204": { "description": "Password changed and other sessions revoked" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/password/forgot": {
      "post": {
        "tags": ["Identity"], "operationId": "requestPasswordReset", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/EmailRequest" } } } },
        "responses": { "202": { "description": "Request accepted whether or not the account exists" }, "429": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/password/reset": {
      "post": {
        "tags": ["Identity"], "operationId": "resetPassword", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasswordResetRequest" } } } },
        "responses": { "204": { "description": "Password changed and all sessions revoked" }, "400": { "$ref": "#/components/responses/Problem" }, "410": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/email/verify": {
      "post": {
        "tags": ["Identity"], "operationId": "verifyEmail", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TokenRequest" } } } },
        "responses": { "204": { "description": "Email verified" }, "400": { "$ref": "#/components/responses/Problem" }, "410": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/passkeys/registration/options": {
      "post": {
        "tags": ["Identity"], "operationId": "createPasskeyRegistrationOptions",
        "responses": { "200": { "description": "WebAuthn creation options", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebAuthnOptions" } } } }, "401": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/passkeys/registration/complete": {
      "post": {
        "tags": ["Identity"], "operationId": "completePasskeyRegistration", "parameters": [{ "$ref": "#/components/parameters/StepUpGrant" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebAuthnCredential" } } } },
        "responses": { "201": { "description": "Passkey registered", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Passkey" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/passkeys": {
      "get": {
        "tags": ["Account"], "operationId": "listPasskeys",
        "responses": { "200": { "description": "Registered passkeys", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Passkey" } } } } } }
      }
    },
    "/passkeys/{passkeyId}": {
      "delete": {
        "tags": ["Account"], "operationId": "removePasskey", "parameters": [{ "$ref": "#/components/parameters/PasskeyId" }, { "$ref": "#/components/parameters/StepUpGrant" }],
        "responses": { "204": { "description": "Passkey revoked" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/passkeys/authentication/options": {
      "post": {
        "tags": ["Identity"], "operationId": "createPasskeyAuthenticationOptions", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PasskeyAuthenticationOptionsRequest" } } } },
        "responses": { "200": { "description": "WebAuthn request options", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebAuthnOptions" } } } }, "429": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/passkeys/authentication/complete": {
      "post": {
        "tags": ["Identity"], "operationId": "completePasskeyAuthentication", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WebAuthnCredential" } } } },
        "responses": { "200": { "$ref": "#/components/responses/TokenPair" }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/step-up/options": {
      "post": {
        "tags": ["Identity"], "operationId": "createStepUpOptions",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StepUpIntent" } } } },
        "responses": { "200": { "description": "Allowed authentication methods and WebAuthn options", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StepUpOptions" } } } }, "400": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/auth/step-up/complete": {
      "post": {
        "tags": ["Identity"], "operationId": "completeStepUp",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StepUpCompletion" } } } },
        "responses": { "200": { "description": "Intent-bound step-up grant", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StepUpGrant" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/me": {
      "get": { "tags": ["Account"], "operationId": "getProfile", "responses": { "200": { "description": "Current profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Profile" } } } }, "401": { "$ref": "#/components/responses/Problem" } } },
      "patch": {
        "tags": ["Account"], "operationId": "updateProfile", "parameters": [{ "$ref": "#/components/parameters/StepUpGrant" }],
        "requestBody": { "required": true, "content": { "application/merge-patch+json": { "schema": { "$ref": "#/components/schemas/ProfileUpdate" } } } },
        "responses": { "200": { "description": "Updated profile", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Profile" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } }
      },
      "delete": {
        "tags": ["Account"], "operationId": "deleteAccount", "parameters": [{ "$ref": "#/components/parameters/StepUpGrant" }],
        "responses": { "202": { "description": "Deletion accepted; sessions and devices revoked" }, "401": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/me/export": {
      "post": {
        "tags": ["Account"], "operationId": "requestDataExport", "parameters": [{ "$ref": "#/components/parameters/StepUpGrant" }],
        "responses": { "202": { "description": "Export job created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExportJob" } } } }, "403": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/me/export/{exportId}": {
      "get": {
        "tags": ["Account"], "operationId": "getDataExport", "parameters": [{ "$ref": "#/components/parameters/ExportId" }],
        "responses": { "200": { "description": "Export status and short-lived URL when ready", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExportJob" } } } }, "404": { "$ref": "#/components/responses/Problem" }, "410": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/me/export/{exportId}/download": {
      "get": {
        "tags": ["Account"], "operationId": "downloadDataExport", "parameters": [{ "$ref": "#/components/parameters/ExportId" }],
        "responses": { "200": { "description": "Decrypted short-lived user export", "content": { "application/json": { "schema": { "type": "object", "additionalProperties": true } } } }, "404": { "$ref": "#/components/responses/Problem" }, "410": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/sessions": {
      "get": {
        "tags": ["Account"], "operationId": "listSessions", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }],
        "responses": { "200": { "description": "Sessions", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SessionPage" } } } } }
      }
    },
    "/sessions/{sessionId}": {
      "delete": {
        "tags": ["Account"], "operationId": "revokeSession", "parameters": [{ "$ref": "#/components/parameters/SessionId" }],
        "responses": { "204": { "description": "Session revoked" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/device-enrollments": {
      "post": {
        "tags": ["Enrollment"], "operationId": "createDeviceEnrollment", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceEnrollmentRequest" } } } },
        "responses": { "201": { "description": "Pending enrollment", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceEnrollment" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/device-enrollments/{userCode}/approve": {
      "post": {
        "tags": ["Enrollment"], "operationId": "approveDeviceEnrollment", "parameters": [{ "$ref": "#/components/parameters/UserCode" }],
        "responses": { "204": { "description": "Enrollment approved" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "410": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/device-enrollments/token": {
      "post": {
        "tags": ["Enrollment"], "operationId": "exchangeDeviceCode", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceCodeRequest" } } } },
        "responses": { "200": { "description": "Approved device credential", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceTokenPair" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "410": { "$ref": "#/components/responses/Problem" }, "429": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent/auth/refresh": {
      "post": {
        "tags": ["Agent"], "operationId": "refreshDeviceCredential", "security": [],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshRequest" } } } },
        "responses": { "200": { "description": "Rotated device credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceTokenPair" } } } }, "401": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/devices": {
      "get": {
        "tags": ["Devices"], "operationId": "listDevices", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }],
        "responses": { "200": { "description": "Owned devices", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DevicePage" } } } } }
      }
    },
    "/devices/{deviceId}": {
      "get": { "tags": ["Devices"], "operationId": "getDevice", "parameters": [{ "$ref": "#/components/parameters/DeviceId" }], "responses": { "200": { "description": "Device", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Device" } } } }, "404": { "$ref": "#/components/responses/Problem" } } },
      "patch": {
        "tags": ["Devices"], "operationId": "updateDevice", "parameters": [{ "$ref": "#/components/parameters/DeviceId" }],
        "requestBody": { "required": true, "content": { "application/merge-patch+json": { "schema": { "$ref": "#/components/schemas/DeviceUpdate" } } } },
        "responses": { "200": { "description": "Updated device", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Device" } } } }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } }
      },
      "delete": { "tags": ["Devices"], "operationId": "revokeDevice", "parameters": [{ "$ref": "#/components/parameters/DeviceId" }, { "$ref": "#/components/parameters/StepUpGrant" }], "responses": { "204": { "description": "Device and credentials revoked" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } } }
    },
    "/devices/{deviceId}/windows-sids": {
      "get": {
        "tags": ["Devices"], "operationId": "listDeviceWindowsSids", "parameters": [{ "$ref": "#/components/parameters/DeviceId" }],
        "responses": { "200": { "description": "Authorized and pending interactive Windows identities", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/WindowsSidStatus" } } } } }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/devices/{deviceId}/windows-sids/{windowsSid}/authorize": {
      "post": {
        "tags": ["Devices"], "operationId": "authorizeDeviceWindowsSid", "parameters": [{ "$ref": "#/components/parameters/DeviceId" }, { "$ref": "#/components/parameters/WindowsSid" }, { "$ref": "#/components/parameters/StepUpGrant" }],
        "responses": { "204": { "description": "Windows identity authorized" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "410": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/devices/{deviceId}/windows-sids/{windowsSid}": {
      "delete": {
        "tags": ["Devices"], "operationId": "revokeDeviceWindowsSid", "parameters": [{ "$ref": "#/components/parameters/DeviceId" }, { "$ref": "#/components/parameters/WindowsSid" }, { "$ref": "#/components/parameters/StepUpGrant" }],
        "responses": { "204": { "description": "Windows identity authorization revoked" }, "403": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/devices/{deviceId}/commands": {
      "post": {
        "tags": ["Commands"], "operationId": "createCommand", "parameters": [{ "$ref": "#/components/parameters/DeviceId" }, { "$ref": "#/components/parameters/IdempotencyKey" }, { "$ref": "#/components/parameters/StepUpGrantOptional" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandCreate" } } } },
        "responses": { "202": { "description": "Durably queued command", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Command" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "403": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "422": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/commands": {
      "get": {
        "tags": ["Commands"], "operationId": "listCommands", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }],
        "responses": { "200": { "description": "Owned command projections ordered by latest change", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandPage" } } } } }
      }
    },
    "/commands/{commandId}": {
      "get": { "tags": ["Commands"], "operationId": "getCommand", "parameters": [{ "$ref": "#/components/parameters/CommandId" }], "responses": { "200": { "description": "Command status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Command" } } } }, "404": { "$ref": "#/components/responses/Problem" } } }
    },
    "/commands/{commandId}/cancel": {
      "post": { "tags": ["Commands"], "operationId": "cancelCommand", "parameters": [{ "$ref": "#/components/parameters/CommandId" }], "responses": { "200": { "description": "Cancelled command", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Command" } } } }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } } }
    },
    "/agent/heartbeat": {
      "post": {
        "tags": ["Agent"], "operationId": "heartbeat", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Heartbeat" } } } },
        "responses": { "204": { "description": "Presence updated" }, "401": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent/windows-sid-candidates": {
      "post": {
        "tags": ["Agent"], "operationId": "registerWindowsSidCandidate",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WindowsSidCandidateRequest" } } } },
        "responses": { "200": { "description": "Current candidate or authorization state", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/WindowsSidStatus" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "401": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent/commands": {
      "get": {
        "tags": ["Agent"], "operationId": "listPendingCommands", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }],
        "responses": { "200": { "description": "Unexpired commands for the authenticated device", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandPage" } } } } }
      }
    },
    "/agent/commands/{commandId}/claim": {
      "post": {
        "tags": ["Agent"], "operationId": "claimCommand", "parameters": [{ "$ref": "#/components/parameters/CommandId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandClaim" } } } },
        "responses": { "200": { "description": "Claimed command with 30-second lease", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Command" } } } }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" }, "410": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/agent/commands/{commandId}/acknowledgements": {
      "post": {
        "tags": ["Agent"], "operationId": "acknowledgeCommand", "parameters": [{ "$ref": "#/components/parameters/CommandId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CommandAcknowledgement" } } } },
        "responses": { "200": { "description": "Updated command", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Command" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/reminders": {
      "get": {
        "tags": ["Reminders"], "operationId": "listReminders", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }],
        "responses": { "200": { "description": "Reminders", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReminderPage" } } } } }
      },
      "post": {
        "tags": ["Reminders"], "operationId": "createReminder", "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReminderWrite" } } } },
        "responses": { "201": { "description": "Reminder created", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reminder" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/reminders/{reminderId}": {
      "get": { "tags": ["Reminders"], "operationId": "getReminder", "parameters": [{ "$ref": "#/components/parameters/ReminderId" }], "responses": { "200": { "description": "Reminder", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reminder" } } } }, "404": { "$ref": "#/components/responses/Problem" } } },
      "patch": {
        "tags": ["Reminders"], "operationId": "updateReminder", "parameters": [{ "$ref": "#/components/parameters/ReminderId" }],
        "requestBody": { "required": true, "content": { "application/merge-patch+json": { "schema": { "$ref": "#/components/schemas/ReminderWrite" } } } },
        "responses": { "200": { "description": "Updated reminder", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reminder" } } } }, "400": { "$ref": "#/components/responses/Problem" }, "404": { "$ref": "#/components/responses/Problem" }, "409": { "$ref": "#/components/responses/Problem" } }
      },
      "delete": { "tags": ["Reminders"], "operationId": "deleteReminder", "parameters": [{ "$ref": "#/components/parameters/ReminderId" }], "responses": { "204": { "description": "Reminder cancelled and deleted" }, "404": { "$ref": "#/components/responses/Problem" } } }
    },
    "/agent/reminder-deliveries": {
      "get": {
        "tags": ["Agent"], "operationId": "listAvailableReminderDeliveries", "parameters": [{ "$ref": "#/components/parameters/Cursor" }, { "$ref": "#/components/parameters/Limit" }],
        "responses": { "200": { "description": "Available reminder deliveries for the authenticated device", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReminderDeliveryPage" } } } }, "401": { "$ref": "#/components/responses/Problem" } }
      }
    },
    "/reminder-deliveries/{deliveryId}/acknowledgements": {
      "post": {
        "tags": ["Agent"], "operationId": "acknowledgeReminderDelivery", "parameters": [{ "$ref": "#/components/parameters/DeliveryId" }],
