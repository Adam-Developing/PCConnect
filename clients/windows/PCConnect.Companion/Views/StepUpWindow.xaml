<Window x:Class="PCConnect.Companion.Views.StepUpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm" Width="460" SizeToContent="Height"
        Style="{StaticResource AppWindow}" Background="{StaticResource Surface}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

  <StackPanel Margin="24">
    <StackPanel Orientation="Horizontal">
      <Border Width="44" Height="44" CornerRadius="12" Background="{StaticResource DangerTint}"
              VerticalAlignment="Top">
        <Path x:Name="CommandIcon" Fill="{StaticResource Danger}" Width="24" Height="24"
              Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>

      <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="PromptText" Style="{StaticResource Heading}" />
        <TextBlock x:Name="DeviceStatusText" Style="{StaticResource Caption}" Margin="0,2,0,0" />
      </StackPanel>
    </StackPanel>

    <TextBlock Style="{StaticResource Subtle}" Margin="0,14,0,0" LineHeight="20">
      <Run Text="This ends whatever is running there. You're already signed in, but it still needs your " />
      <Run Text="PCConnect password" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
      <Run Text=" — the one you sign in to this app with, not your Windows password." />
    </TextBlock>

    <TextBlock Text="PCConnect password" Style="{StaticResource FieldLabel}" Margin="0,16,0,5" />
    <PasswordBox x:Name="PasswordBox" KeyDown="OnKeyDown" />

    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerInk}" FontSize="12.5"
               Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" Click="OnCancel" IsCancel="True" Margin="0,0,8,0" Padding="16,0" Height="38" />
      <Button x:Name="ConfirmButton" Click="OnConfirm" IsDefault="True"
              Style="{StaticResource DestructiveButton}" Padding="16,0" Height="38" />
    </StackPanel>
  </StackPanel>
</Window>
