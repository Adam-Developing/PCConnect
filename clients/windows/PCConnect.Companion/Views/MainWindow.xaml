<Window x:Class="PCConnect.Companion.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCConnect.Companion.ViewModels"
        Title="PCConnect" Height="760" Width="1180" MinHeight="620" MinWidth="960"
        Style="{StaticResource AppWindow}"
        Icon="pack://application:,,,/PCConnect.Companion;component/Resources/logo.png"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <vm:BoolToVisibilityConverter x:Key="BoolToVis" />
    <vm:InverseBoolToVisibilityConverter x:Key="NotBoolToVis" />
    <vm:StringToVisibilityConverter x:Key="TextToVis" />
    <vm:NullToVisibilityConverter x:Key="NotNullToVis" />
    <vm:NullToVisibleConverter x:Key="NullToVis" />
    <vm:InverseBoolConverter x:Key="NotBool" />
    <vm:ConnectionTextConverter x:Key="ConnectionText" />
    <vm:EnumToBoolConverter x:Key="EnumToBool" />
    <vm:EnumToVisibilityConverter x:Key="EnumToVis" />
    <vm:ColourToBrushConverter x:Key="ColourToBrush" />
    <vm:ToneToInkConverter x:Key="ToneInk" />
    <vm:ToneToTintConverter x:Key="ToneTint" />
    <vm:OnlineToBrushConverter x:Key="OnlineBrush" />
    <vm:DestructiveToBrushConverter x:Key="DangerText" />
    <vm:DestructiveToIconBrushConverter x:Key="DangerIcon" />
    <vm:IconKeyConverter x:Key="IconKey" />
    <vm:BoolToDimConverter x:Key="Dim" />
    <vm:BoolToStrikethroughConverter x:Key="Strike" />

    <!-- One reminder row, shared by This PC and Reminders. -->
    <DataTemplate x:Key="ReminderRowTemplate">
      <StackPanel Margin="0,7" Opacity="{Binding IsPast, Converter={StaticResource Dim}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" FontSize="12"
                     Foreground="{StaticResource InkSoft}" />
          <TextBlock Text="{Binding DayLabel}" Style="{StaticResource Caption}" FontSize="12"
                     Foreground="{StaticResource InkSoft}" Margin="8,0,0,0" />
          <TextBlock Text="Done" FontSize="12" FontWeight="Medium" Margin="8,0,0,0"
                     Foreground="{StaticResource OnlineInk}"
                     Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
        <TextBlock Text="{Binding Body}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   TextDecorations="{Binding IsCompleted, Converter={StaticResource Strike}}" />
        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis"
                   Visibility="{Binding Detail, Converter={StaticResource TextToVis}}" />
      </StackPanel>
    </DataTemplate>

    <!-- One line of an activity log. -->
    <DataTemplate x:Key="ActivityRowTemplate">
      <Grid Margin="0,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Event}" Style="{StaticResource Body}" FontSize="13.5"
                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}" FontSize="12"
                       Foreground="{StaticResource InkFaint}" />
            <TextBlock Text=" · " Style="{StaticResource Caption}" />
            <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Pill}"
                Background="{Binding Tone, Converter={StaticResource ToneTint}}">
          <TextBlock Text="{Binding Outcome}" Style="{StaticResource PillText}"
                     Foreground="{Binding Tone, Converter={StaticResource ToneInk}}" />
        </Border>
      </Grid>
    </DataTemplate>

    <!-- A day in a month grid. -->
    <DataTemplate x:Key="DayCellTemplate">
      <Button Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}" BorderThickness="0" Padding="0" Height="30" Margin="1"
              Background="Transparent">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="7" Background="Transparent">
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="Num" Text="{Binding Number}" FontSize="12.5"
                           HorizontalAlignment="Center" Foreground="{StaticResource Ink}" />
                <Ellipse x:Name="Dot" Width="4" Height="4" Margin="0,1,0,0"
                         Fill="Transparent" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding InMonth}" Value="False">
                <Setter TargetName="Num" Property="Foreground" Value="{StaticResource InkDisabled}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding HasEvents}" Value="True">
                <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Accent}" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsToday}" Value="True">
                <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Primary}" />
                <Setter TargetName="Num" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
              </DataTrigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Primary}" />
                <Setter TargetName="Num" Property="Foreground" Value="White" />
                <Setter TargetName="Num" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Dot" Property="Fill" Value="White" />
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Track}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>

    <Style x:Key="WeekdayHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource InkFaint}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Window.Resources>

  <Grid>

    <!-- ══════════════════════════ signed out ══════════════════════════ -->
    <Grid Visibility="{Binding IsSignedIn, Converter={StaticResource NotBoolToVis}}"
          Background="{StaticResource Ground}">
      <StackPanel Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Style="{StaticResource Card}" Padding="28">
          <StackPanel>
            <Image Source="pack://application:,,,/PCConnect.Companion;component/Resources/logo.png" Width="48" Height="48" HorizontalAlignment="Left" />

            <TextBlock Text="Sign in to PCConnect" Style="{StaticResource PageTitle}" Margin="0,16,0,0" />
            <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0" LineHeight="20"
                       Text="Use the account you use on your phone. Your password is checked on the server and never stored here." />

            <TextBlock Text="Username or email" Style="{StaticResource FieldLabel}" Margin="0,22,0,5" />
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="0,12,0,5" />
            <PasswordBox x:Name="PasswordBox" KeyDown="OnPasswordKeyDown" />

            <Button Content="Sign in" Click="OnSignInClick" Style="{StaticResource PrimaryButton}"
                    Height="40" Margin="0,18,0,0"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />

            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerInk}"
                       FontSize="12.5" Margin="0,10,0,0" TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource TextToVis}}" />
          </StackPanel>
        </Border>

        <Border Background="{StaticResource PrimaryTint}" CornerRadius="12" Padding="16,14" Margin="0,16,0,0">
          <StackPanel Orientation="Horizontal">
            <Path Data="{StaticResource Icon.DesktopWindows}" Fill="{StaticResource Primary}"
                  Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource Body}" FontSize="13" Margin="12,0,0,0" LineHeight="19"
                       TextWrapping="Wrap" Width="290">
              <Run Text="Once this PC is added to your account it appears on your phone as" />
              <Run Text="{Binding ThisPcName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="." />
            </TextBlock>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- ══════════════════════════ signed in ═══════════════════════════ -->
    <Grid Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="216" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- ── sidebar ─────────────────────────────────────────────────── -->
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
              BorderThickness="0,0,1,0">
        <DockPanel Margin="12,14">

          <!-- account, pinned to the bottom -->
          <Grid DockPanel.Dock="Bottom">
            <Popup IsOpen="{Binding IsAccountMenuOpen}" Placement="Top" AllowsTransparency="True"
                   StaysOpen="False" HorizontalOffset="0" VerticalOffset="-6" Width="192">
              <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                      BorderThickness="1" CornerRadius="12" Padding="6">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.14" Color="#0F172A" />
                </Border.Effect>
                <StackPanel>
                  <StackPanel Margin="10,8,10,6">
                    <TextBlock Text="{Binding Account.DisplayName}" Style="{StaticResource Body}"
                               FontSize="13.5" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Account.Email}" Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  </StackPanel>

                  <Border Style="{StaticResource Hairline}" Margin="4,2" />

                  <Grid Margin="10,6">
                    <TextBlock Text="This PC" Style="{StaticResource Caption}" FontSize="11.5"
                               Foreground="{StaticResource InkSoft}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding ThisPcName}" Style="{StaticResource Caption}"
                               FontSize="11.5" Foreground="{StaticResource Ink}"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
                  </Grid>

                  <Border Style="{StaticResource Hairline}" Margin="4,2" />

                  <Button Content="Sign out of this PC" Command="{Binding SignOutCommand}"
                          Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerInk}"
                          HorizontalContentAlignment="Left" Padding="10,8" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </Popup>

            <Button Command="{Binding ToggleAccountMenuCommand}" BorderThickness="0"
                    Background="Transparent" Padding="6,8" HorizontalContentAlignment="Stretch">
              <DockPanel>
                <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource PrimaryTint}"
                        DockPanel.Dock="Left">
                  <TextBlock Text="{Binding Account.Initials}" Foreground="{StaticResource Primary}"
                             FontSize="12.5" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Path Data="{StaticResource Icon.ExpandMore}" Fill="{StaticResource InkFaint}"
                      Width="20" Height="20" Stretch="Uniform" DockPanel.Dock="Right"
                      VerticalAlignment="Center" />

                <StackPanel Margin="10,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Account.DisplayName}" Style="{StaticResource Body}"
                             FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             TextWrapping="NoWrap" />
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                             Fill="{Binding IsRealtimeConnected, Converter={StaticResource OnlineBrush}}" />
                    <TextBlock Text="{Binding IsRealtimeConnected, Converter={StaticResource ConnectionText}}"
                               FontSize="12" Margin="5,0,0,0"
                               Foreground="{StaticResource InkSoft}" />
                  </StackPanel>
                </StackPanel>
              </DockPanel>
            </Button>
          </Grid>

          <Border DockPanel.Dock="Bottom" Style="{StaticResource Hairline}" Margin="0,6" />

          <!-- the four pages -->
          <StackPanel DockPanel.Dock="Top">
            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                         Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:CompanionPage.ThisPc}"
                         IsChecked="{Binding Page, Converter={StaticResource EnumToBool}, ConverterParameter=ThisPc, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.DesktopWindows}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="This PC" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                         Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:CompanionPage.OtherPcs}"
                         IsChecked="{Binding Page, Converter={StaticResource EnumToBool}, ConverterParameter=OtherPcs, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.Devices}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="Other PCs" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                         Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:CompanionPage.Reminders}"
                         IsChecked="{Binding Page, Converter={StaticResource EnumToBool}, ConverterParameter=Reminders, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.Notifications}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="Reminders" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              </StackPanel>
            </RadioButton>

            <RadioButton Style="{StaticResource NavItem}" GroupName="Nav"
                         Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:CompanionPage.Settings}"
                         IsChecked="{Binding Page, Converter={StaticResource EnumToBool}, ConverterParameter=Settings, Mode=OneWay}">
              <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.Settings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                      Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Text="Settings" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
              </StackPanel>
            </RadioButton>
          </StackPanel>

          <Grid />
        </DockPanel>
      </Border>

      <!-- ── content ─────────────────────────────────────────────────── -->
      <Grid Grid.Column="1" Background="{StaticResource Ground}">

        <!-- the update prompt: the lever that ends the legacy era (04 §2) -->
        <Border VerticalAlignment="Top" Background="{StaticResource WarnTint}" Padding="20,10"
                Panel.ZIndex="2"
                Visibility="{Binding UpdateNotice, Converter={StaticResource TextToVis}}">
          <TextBlock Text="{Binding UpdateNotice}" Foreground="{StaticResource WarnInk}" FontSize="13" />
        </Border>

        <!-- ═══ This PC ═══ -->
        <Grid Visibility="{Binding Page, Converter={StaticResource EnumToVis}, ConverterParameter=ThisPc}">
          <Grid Margin="32,28">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="False">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Bottom">
                <TextBlock Text="PCConnect" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{Binding ThisPcName}" Style="{StaticResource Subtle}" FontSize="16"
                           FontWeight="Medium" Margin="12,0,0,2" VerticalAlignment="Bottom" />
              </StackPanel>
              <TextBlock Text="{Binding Today}" Style="{StaticResource Caption}" DockPanel.Dock="Right"
                         VerticalAlignment="Bottom" />
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}" Margin="0,0,8,0" VerticalAlignment="Top">
                <StackPanel>
                  <DockPanel LastChildFill="False">
                    <TextBlock Text="Connection" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" />
                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"
                            Background="{StaticResource OnlineTint}">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                 Fill="{Binding IsRealtimeConnected, Converter={StaticResource OnlineBrush}}" />
                        <TextBlock Text="{Binding IsRealtimeConnected, Converter={StaticResource ConnectionText}}"
                                   Style="{StaticResource PillText}" Foreground="{StaticResource OnlineInk}"
                                   Margin="6,0,0,0" />
                      </StackPanel>
                    </Border>
                  </DockPanel>

                  <Grid Margin="0,14,0,0">
                    <TextBlock Text="Signed in as" Style="{StaticResource Subtle}"
                               Foreground="{StaticResource InkSoft}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding Account.DisplayName}" Style="{StaticResource Subtle}"
                               FontWeight="Medium" HorizontalAlignment="Right" />
                  </Grid>

                  <Grid Margin="0,10,0,0">
                    <TextBlock Text="Last command" Style="{StaticResource Subtle}"
                               Foreground="{StaticResource InkSoft}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding LastCommandSummary}" Style="{StaticResource Subtle}"
                               FontWeight="Medium" HorizontalAlignment="Right" />
                  </Grid>

                  <Border Style="{StaticResource Note}" Margin="0,14,0,0">
                    <DockPanel>
                      <Path Data="{StaticResource Icon.Smartphone}" Fill="{StaticResource InkFaint}"
                            Width="18" Height="18" Stretch="Uniform" DockPanel.Dock="Left"
                            VerticalAlignment="Top" />
                      <TextBlock Style="{StaticResource Subtle}" FontSize="13" Margin="10,0,0,0"
                                 TextWrapping="Wrap" LineHeight="19">
                        <Run Text="This PC is controlled from your phone. To control your other PCs from here, open" />
                        <Run Text="Other PCs" FontWeight="SemiBold" Foreground="{StaticResource Ink}" /><Run Text="." />
                      </TextBlock>
                    </DockPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                  <DockPanel LastChildFill="False">
                    <TextBlock Text="Today" Style="{StaticResource CardTitle}" DockPanel.Dock="Left" />
                    <TextBlock Text="{Binding WeekSummary}" Style="{StaticResource Caption}"
                               DockPanel.Dock="Right" VerticalAlignment="Center" />
                  </DockPanel>

                  <ItemsControl ItemsSource="{Binding Week[0].Items}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,6">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}"
                                     Foreground="{StaticResource InkSoft}" />
                          <TextBlock Grid.Column="1" Text="{Binding Body}" Style="{StaticResource Body}"
                                     TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="Nothing on this screen today." Style="{StaticResource Caption}"
                             Margin="0,8,0,0"
                             Visibility="{Binding Week[0].IsEmpty, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
              </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,12">
                  <TextBlock Text="This week on this screen" Style="{StaticResource CardTitle}"
                             DockPanel.Dock="Left" />
                  <TextBlock Text="{Binding WeekSummary}" Style="{StaticResource Caption}"
                             DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center" />
                  <Button Content="Open Reminders →" Style="{StaticResource LinkButton}"
                          DockPanel.Dock="Right" Command="{Binding NavigateCommand}"
                          CommandParameter="{x:Static vm:CompanionPage.Reminders}" />
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Week}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="Col" CornerRadius="10" Background="{StaticResource Track}"
                              Padding="10" Margin="4">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Label" Text="{Binding Label}" FontSize="12"
                                       FontWeight="SemiBold" Foreground="{StaticResource InkSoft}" />
                            <TextBlock Text="{Binding Number}" FontSize="12" Margin="6,0,0,0"
                                       Foreground="{StaticResource InkFaint}" />
                          </StackPanel>

                          <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                  <StackPanel>
                                    <TextBlock Text="{Binding Time}" Style="{StaticResource Mono}"
                                               FontSize="11.5" Foreground="{StaticResource InkSoft}" />
                                    <TextBlock Text="{Binding Body}" FontSize="12.5" TextWrapping="Wrap"
                                               MaxHeight="34" Foreground="{StaticResource Ink}" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <TextBlock Text="Nothing" FontSize="12" Foreground="{StaticResource InkDisabled}"
                                     Margin="0,4,0,0"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                          <Setter TargetName="Col" Property="Background" Value="{StaticResource PrimaryTint}" />
                          <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Primary}" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- ═══ Other PCs ═══ -->
        <Grid Visibility="{Binding Page, Converter={StaticResource EnumToVis}, ConverterParameter=OtherPcs}">
          <Grid DataContext="{Binding Devices}" Margin="32,28">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
              <TextBlock Text="Other PCs" Style="{StaticResource PageTitle}" />
              <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0"
                         Text="Every PC on this account, apart from the one you're sitting at." />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <DockPanel Margin="0,0,16,0">
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource InkDisabled}"
                        BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,10,0,0">
                  <StackPanel>
                    <TextBlock Text="Add another PC" Style="{StaticResource Body}" FontWeight="SemiBold"
                               FontSize="13.5" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,8" TextWrapping="Wrap"
                               Text="Sign in on that PC and type the code it shows." />
                    <TextBox Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="{StaticResource MonoFont}" Height="36" />
                    <Button Content="Add this PC" Command="{Binding ClaimPairingCommand}"
                            Style="{StaticResource PrimaryButton}" Height="36" Margin="0,8,0,0" />
                  </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Others}" SelectedItem="{Binding SelectedDevice}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <DockPanel>
                        <Path Data="{StaticResource Icon.ChevronRight}" Fill="{StaticResource InkDisabled}"
                              Width="20" Height="20" Stretch="Uniform" DockPanel.Dock="Right"
                              VerticalAlignment="Center" />
                        <StackPanel>
                          <TextBlock Text="{Binding DisplayName}" Style="{StaticResource CardTitle}" />
                          <DockPanel Margin="0,2,0,0">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" DockPanel.Dock="Left"
                                     Fill="{Binding IsOnline, Converter={StaticResource OnlineBrush}}" />
                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}"
                                       Foreground="{StaticResource InkSoft}" Margin="6,0,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                          </DockPanel>
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>

              <!-- no other PCs at all -->
              <Border Grid.Column="1" Style="{StaticResource Card}" VerticalAlignment="Top"
                      Visibility="{Binding SelectedDevice, Converter={StaticResource NullToVis}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,40">
                  <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource PrimaryTint}">
                    <Path Data="{StaticResource Icon.Devices}" Fill="{StaticResource Primary}"
                          Width="32" Height="32" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Text="No other PCs yet" Style="{StaticResource Heading}"
                             HorizontalAlignment="Center" Margin="0,18,0,0" />
                  <TextBlock Style="{StaticResource Subtle}" HorizontalAlignment="Center" Margin="0,8,0,0"
                             TextAlignment="Center" MaxWidth="360" TextWrapping="Wrap"
                             Text="Install PCConnect on another Windows PC, sign in with this account, and add it with the code it shows." />
                </StackPanel>
              </Border>

              <!-- the selected PC -->
              <DockPanel Grid.Column="1"
                         Visibility="{Binding SelectedDevice, Converter={StaticResource NotNullToVis}}">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
                  <StackPanel>
                    <DockPanel LastChildFill="False">
                      <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding SelectedDevice.DisplayName}" Style="{StaticResource Heading}"
                                   FontSize="17" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                          <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                   Fill="{Binding SelectedDevice.IsOnline, Converter={StaticResource OnlineBrush}}" />
                          <TextBlock Text="{Binding SelectedDevice.Summary}" Style="{StaticResource Caption}"
                                     Foreground="{StaticResource InkSoft}" Margin="6,0,0,0" />
                        </StackPanel>
                      </StackPanel>

                      <Button DockPanel.Dock="Right" Command="{Binding ShowLogCommand}"
                              Padding="10,0" Height="32" ToolTip="Activity for this PC">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource Icon.History}" Fill="{StaticResource InkSoft}"
                                Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                          <TextBlock Text="Activity" Margin="6,0,0,0" VerticalAlignment="Center"
                                     Foreground="{StaticResource Ink}" FontSize="12.5" />
                        </StackPanel>
                      </Button>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding SelectedCommands}" Margin="0,14,0,0">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource CommandButton}" Margin="0,0,8,8"
                                  Command="{Binding DataContext.SendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding Type}">
                            <DockPanel>
                              <Path Data="{Binding IconKey, Converter={StaticResource IconKey}}"
                                    Fill="{Binding IsDestructive, Converter={StaticResource DangerIcon}}"
                                    Width="20" Height="20" Stretch="Uniform" DockPanel.Dock="Left"
                                    VerticalAlignment="Center" />
                              <Path Data="{StaticResource Icon.Key}" Fill="{StaticResource InkFaint}"
                                    Width="15" Height="15" Stretch="Uniform" DockPanel.Dock="Right"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding AsksForPassword, Converter={StaticResource BoolToVis}}" />
                              <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center"
                                         FontWeight="SemiBold"
                                         Foreground="{Binding IsDestructive, Converter={StaticResource DangerText}}" />
                            </DockPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel LastChildFill="False">
                      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Path Data="{StaticResource Icon.Key}" Fill="{StaticResource InkFaint}"
                              Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock Text="Asks for your password before it's sent"
                                   Style="{StaticResource Caption}" Margin="6,0,0,0" />
                      </StackPanel>
                      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                                 DockPanel.Dock="Right" Foreground="{StaticResource InkSoft}" />
                    </DockPanel>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Rename this PC" Style="{StaticResource CardTitle}" />
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,4,0,10"
                               Text="How it appears on your phone and your other PCs." />
                    <DockPanel DockPanel.Dock="Top">
                      <Button DockPanel.Dock="Right" Content="Save" Command="{Binding RenameCommand}"
                              Height="36" Padding="16,0" Margin="8,0,0,0" />
                      <TextBox Text="{Binding RenameTo, UpdateSourceTrigger=PropertyChanged}" Height="36" />
                    </DockPanel>
                    <Grid />
                  </DockPanel>
                </Border>
              </DockPanel>
            </Grid>
          </Grid>

          <!-- the activity log, over the page -->
          <Grid Background="#730F172A" DataContext="{Binding Devices}"
                Visibility="{Binding IsLogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="680" MaxHeight="580" Background="{StaticResource Surface}" CornerRadius="14"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
              <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="16" Opacity="0.3" Color="#0F172A" />
              </Border.Effect>
              <DockPanel Margin="22,20">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                  <StackPanel DockPanel.Dock="Left">
                    <TextBlock Style="{StaticResource CardTitle}" FontSize="17">
                      <Run Text="Activity · " /><Run Text="{Binding SelectedDevice.DisplayName, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Every command sent to this PC, newest first. Nothing secret is recorded." />
                  </StackPanel>
                  <Button DockPanel.Dock="Right" Command="{Binding CloseLogCommand}" BorderThickness="0"
                          Background="Transparent" Padding="6" VerticalAlignment="Top">
                    <Path Data="{StaticResource Icon.Close}" Fill="{StaticResource InkSoft}"
                          Width="20" Height="20" Stretch="Uniform" />
                  </Button>
                </DockPanel>

                <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding SelectedActivity}"
                                ItemTemplate="{StaticResource ActivityRowTemplate}" />
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- ═══ Reminders ═══ -->
        <Grid Visibility="{Binding Page, Converter={StaticResource EnumToVis}, ConverterParameter=Reminders}">
          <Grid DataContext="{Binding Reminders}" Margin="32,28">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
              <TextBlock Text="Reminders" Style="{StaticResource PageTitle}" />
              <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0"
                         Text="Shown full-screen on the PCs you choose, at the time you choose. Encrypted on the server." />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="216" />
                  </Grid.ColumnDefinitions>

                  <DockPanel Margin="0,0,20,0">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                      <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding ListTitle}" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="{Binding ListSummary}" Style="{StaticResource Caption}"
                                   Margin="0,2,0,0" />
                      </StackPanel>
                      <Button DockPanel.Dock="Right" Content="Show all" Command="{Binding ClearSelectionCommand}"
                              Height="28" Padding="10,0" FontSize="12.5"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>

                    <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ReminderRowTemplate}" />

                        <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding NoRows, Converter={StaticResource BoolToVis}}">
                          <Path Data="{StaticResource Icon.EventAvailable}" Fill="{StaticResource InkDisabled}"
                                Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" />
                          <TextBlock Text="Nothing on these days." Style="{StaticResource Subtle}"
                                     HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                  </DockPanel>

                  <StackPanel Grid.Column="1">
                    <DockPanel>
                      <Button DockPanel.Dock="Left" Command="{Binding PreviousMonthCommand}"
                              BorderThickness="0" Background="Transparent" Padding="4" Width="26" Height="26">
                        <Path Data="{StaticResource Icon.ChevronLeft}" Fill="{StaticResource InkSoft}"
                              Width="18" Height="18" Stretch="Uniform" />
                      </Button>
                      <Button DockPanel.Dock="Right" Command="{Binding NextMonthCommand}"
                              BorderThickness="0" Background="Transparent" Padding="4" Width="26" Height="26">
                        <Path Data="{StaticResource Icon.ChevronRight}" Fill="{StaticResource InkSoft}"
                              Width="18" Height="18" Stretch="Uniform" />
                      </Button>
                      <TextBlock Text="{Binding MonthTitle}" Style="{StaticResource Body}" FontSize="13.5"
                                 FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </DockPanel>

                    <UniformGrid Columns="7" Margin="0,8,0,4">
                      <TextBlock Text="MO" Style="{StaticResource WeekdayHeader}" />
                      <TextBlock Text="TU" Style="{StaticResource WeekdayHeader}" />
                      <TextBlock Text="WE" Style="{StaticResource WeekdayHeader}" />
                      <TextBlock Text="TH" Style="{StaticResource WeekdayHeader}" />
                      <TextBlock Text="FR" Style="{StaticResource WeekdayHeader}" />
                      <TextBlock Text="SA" Style="{StaticResource WeekdayHeader}" />
                      <TextBlock Text="SU" Style="{StaticResource WeekdayHeader}" />
                    </UniformGrid>

                    <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayCellTemplate}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" FontSize="11.5"
                               TextWrapping="Wrap" LineHeight="17"
                               Text="Click a day to see just that day. Click it again to show them all." />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- new reminder -->
              <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Text="New reminder" Style="{StaticResource CardTitle}"
                             Margin="20,16,20,0" />

                  <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0"
                          Padding="20,12,20,16">
                    <StackPanel>
                      <Button Content="Save reminder" Command="{Binding AddCommand}"
                              Style="{StaticResource PrimaryButton}" Height="40"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                      <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                                 Margin="0,8,0,0" TextWrapping="Wrap"
                                 Visibility="{Binding StatusMessage, Converter={StaticResource TextToVis}}" />
                    </StackPanel>
                  </Border>

                  <ScrollViewer Margin="20,12,20,14" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBox Text="{Binding NewBody, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource MultilineTextBox}" />

                      <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,4,0">
                          <TextBlock Text="{Binding DateLabel}" Style="{StaticResource FieldLabel}" />
                          <DatePicker SelectedDate="{Binding NewDate}" Height="36" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                          <TextBlock Text="Time" Style="{StaticResource FieldLabel}" />
                          <TextBox Text="{Binding NewTime, UpdateSourceTrigger=PropertyChanged}"
                                   FontFamily="{StaticResource MonoFont}" Height="36" />
                        </StackPanel>
                      </Grid>

                      <TextBlock Text="Repeat" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                      <ItemsControl ItemsSource="{Binding RepeatChips}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Command="{Binding DataContext.ChooseRepeatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" Margin="0,0,6,6" Height="30" Padding="12,0"
                                    FontSize="12.5">
                              <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                      <Setter Property="Background" Value="{StaticResource Ink}" />
                                      <Setter Property="Foreground" Value="White" />
                                      <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Button.Style>
                              <TextBlock Text="{Binding Label}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- custom repeat -->
                      <Border BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10"
                              Padding="12" Margin="0,6,0,0"
                              Visibility="{Binding IsCustomRepeat, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                          <TextBlock Text="On these days" Style="{StaticResource FieldLabel}" />
                          <ItemsControl ItemsSource="{Binding RepeatDays}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Button Command="{Binding DataContext.ToggleRepeatDayCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}" Margin="1" Padding="0" Height="30">
                                  <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                      <Border x:Name="Bd" CornerRadius="15" BorderThickness="1"
                                              BorderBrush="{StaticResource Border}" Background="Transparent">
                                        <TextBlock x:Name="Initial" Text="{Binding Initial}" FontSize="12.5"
                                                   FontWeight="Medium" Foreground="{StaticResource InkSoft}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                      </Border>
                                      <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOn}" Value="True">
                                          <Setter TargetName="Bd" Property="Background" Value="{StaticResource Primary}" />
                                          <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}" />
                                          <Setter TargetName="Initial" Property="Foreground" Value="White" />
                                          <Setter TargetName="Initial" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                      </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                  </Button.Template>
                                </Button>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>

                          <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,4,0">
                              <TextBlock Text="Repeat every" Style="{StaticResource FieldLabel}" />
                              <ComboBox ItemsSource="{Binding IntervalOptions}" SelectedItem="{Binding IntervalWeeks}"
                                        Height="34" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                              <TextBlock Text="Ends" Style="{StaticResource FieldLabel}" />
                              <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding ClearUntilCommand}"
                                        Width="34" Height="34" Padding="0" Margin="4,0,0,0"
                                        ToolTip="Never ends"
                                        Visibility="{Binding Until, Converter={StaticResource NotNullToVis}}">
                                  <Path Data="{StaticResource Icon.Close}" Fill="{StaticResource InkSoft}"
                                        Width="16" Height="16" Stretch="Uniform" />
                                </Button>
                                <DatePicker SelectedDate="{Binding Until}" Height="34" />
                              </DockPanel>
                            </StackPanel>
                          </Grid>

                          <TextBlock Text="At these times" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                          <WrapPanel>
                            <ItemsControl ItemsSource="{Binding ExtraTimes}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Background="{StaticResource Track}" CornerRadius="999"
                                          Padding="10,0,6,0" Height="30" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="{Binding StringFormat=HH\\:mm}" Style="{StaticResource Mono}"
                                                 FontSize="12.5" VerticalAlignment="Center" />
                                      <Button Command="{Binding DataContext.RemoveTimeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              CommandParameter="{Binding}" BorderThickness="0"
                                              Background="Transparent" Padding="4" Margin="2,0,0,0">
                                        <Path Data="{StaticResource Icon.Close}" Fill="{StaticResource InkFaint}"
                                              Width="14" Height="14" Stretch="Uniform" />
                                      </Button>
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Command="{Binding AddTimeCommand}" Height="30" Padding="8,0" Margin="0,0,6,6"
                                    BorderBrush="{StaticResource InkDisabled}">
                              <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Add}" Fill="{StaticResource Primary}"
                                      Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="Add time" Foreground="{StaticResource Primary}"
                                           FontSize="12.5" Margin="4,0,0,0" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </WrapPanel>

                          <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                     LineHeight="17"
                                     Text="Each time is saved as its own reminder, so they can be ticked off separately." />
                        </StackPanel>
                      </Border>

                      <Border Style="{StaticResource Note}" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource Icon.EventRepeat}" Fill="{StaticResource InkFaint}"
                                Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" />
                          <TextBlock Text="{Binding ScheduleSummary}" Style="{StaticResource Subtle}"
                                     FontSize="12.5" Margin="8,0,0,0" TextWrapping="Wrap" LineHeight="18"
                                     Width="215" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>
          </Grid>
        </Grid>

        <!-- ═══ Settings ═══ -->
        <Grid Visibility="{Binding Page, Converter={StaticResource EnumToVis}, ConverterParameter=Settings}">
          <Grid DataContext="{Binding AppSettings}" Margin="32,28">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel>
              <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
              <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0"
                         Text="How reminders look on this screen, what this PC will accept, and what has happened to it." />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <ScrollViewer Margin="0,0,16,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <Border Style="{StaticResource Card}">
                    <StackPanel>
                      <TextBlock Text="Reminder appearance" Style="{StaticResource CardTitle}" />
                      <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                 Text="Pick colours that are easy on your eyes. Applies to the full-screen reminder only." />

                      <DockPanel Margin="0,14,0,0">
                        <TextBlock Text="Text" Style="{StaticResource Subtle}" DockPanel.Dock="Left"
                                   VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding TextSwatches}" HorizontalAlignment="Right">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Command="{Binding DataContext.PickTextColourCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding Colour}" Margin="4,0,0,0" Padding="0"
                                      Width="26" Height="26">
                                <Button.Template>
                                  <ControlTemplate TargetType="Button">
                                    <Border x:Name="Ring" CornerRadius="13" BorderThickness="1"
                                            BorderBrush="{StaticResource Border}"
                                            Background="{Binding Colour, Converter={StaticResource ColourToBrush}}" />
                                    <ControlTemplate.Triggers>
                                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Primary}" />
                                        <Setter TargetName="Ring" Property="BorderThickness" Value="3" />
                                      </DataTrigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Button.Template>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DockPanel>

                      <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="Background" Style="{StaticResource Subtle}" DockPanel.Dock="Left"
                                   VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding BackgroundSwatches}" HorizontalAlignment="Right">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Command="{Binding DataContext.PickBackgroundColourCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding Colour}" Margin="4,0,0,0" Padding="0"
                                      Width="26" Height="26">
                                <Button.Template>
                                  <ControlTemplate TargetType="Button">
                                    <Border x:Name="Ring" CornerRadius="13" BorderThickness="1"
                                            BorderBrush="{StaticResource Border}"
                                            Background="{Binding Colour, Converter={StaticResource ColourToBrush}}" />
                                    <ControlTemplate.Triggers>
                                      <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource Primary}" />
                                        <Setter TargetName="Ring" Property="BorderThickness" Value="3" />
                                      </DataTrigger>
                                    </ControlTemplate.Triggers>
                                  </ControlTemplate>
                                </Button.Template>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DockPanel>

                      <Border CornerRadius="10" Padding="16,12" Margin="0,14,0,0"
                              Background="{Binding ReminderBackground, Converter={StaticResource ColourToBrush}}">
                        <StackPanel>
                          <TextBlock Text="PREVIEW" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     Foreground="{StaticResource Accent}" />
                          <TextBlock Text="Take the bins out" FontSize="18" FontWeight="SemiBold"
                                     Margin="0,6,0,0"
                                     Foreground="{Binding ReminderForeground, Converter={StaticResource ColourToBrush}}" />
                          <TextBlock Text="Today at 18:00" FontSize="12.5" Opacity="0.7" Margin="0,2,0,0"
                                     Foreground="{Binding ReminderForeground, Converter={StaticResource ColourToBrush}}" />
                        </StackPanel>
                      </Border>
                    </StackPanel>
                  </Border>

                  <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <DockPanel>
                      <Path Data="{StaticResource Icon.Badge}" Fill="{StaticResource InkSoft}"
                            Width="22" Height="22" Stretch="Uniform" DockPanel.Dock="Left"
                            VerticalAlignment="Center" />
                      <StackPanel DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="This PC's name" Style="{StaticResource Body}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="160"
                                   Text="How it appears on your phone and other PCs." />
                      </StackPanel>
                      <TextBox Text="{Binding PcName, UpdateSourceTrigger=PropertyChanged}"
                               Width="140" Height="34" HorizontalAlignment="Right"
                               IsEnabled="{Binding HasThisPc}" />
                    </DockPanel>
                  </Border>

                  <Button Content="Save this PC's name" Command="{Binding RenameThisPcCommand}"
                          Height="36" Margin="0,8,0,0" IsEnabled="{Binding HasThisPc}" />

                  <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <DockPanel>
                      <Path Data="{StaticResource Icon.Power}" Fill="{StaticResource InkSoft}"
                            Width="22" Height="22" Stretch="Uniform" DockPanel.Dock="Left"
                            VerticalAlignment="Center" />
                      <CheckBox Style="{StaticResource LargeSwitch}" IsChecked="{Binding StartWithWindows}"
                                DockPanel.Dock="Right" VerticalAlignment="Center" />
                      <StackPanel Margin="14,0,14,0">
                        <TextBlock Text="Start with Windows" Style="{StaticResource Body}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                   Text="Runs in the tray so reminders appear on this screen without opening the app." />
                      </StackPanel>
                    </DockPanel>
                  </Border>

                  <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                             Foreground="{StaticResource DangerInk}" Margin="0,8,0,0" TextWrapping="Wrap"
                             Visibility="{Binding StatusMessage, Converter={StaticResource TextToVis}}" />
                </StackPanel>
              </ScrollViewer>

              <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
                  <StackPanel>
                    <DockPanel>
                      <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="#CFFAFE"
                              VerticalAlignment="Top" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                          <Path Data="{StaticResource Icon.Sync}" Fill="#0E7490" Width="15" Height="15"
                                Stretch="Uniform" VerticalAlignment="Center" />
                          <TextBlock Text="Synced with your phone" Style="{StaticResource PillText}"
                                     Foreground="#0E7490" Margin="5,0,0,0" />
                        </StackPanel>
                      </Border>
                      <StackPanel>
                        <TextBlock Text="Commands" Style="{StaticResource CardTitle}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                   Text="Accepted is for this PC. Asking for a password is the account's rule." />
                      </StackPanel>
                    </DockPanel>

                    <Grid Margin="0,14,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="140" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="COMMAND" Style="{StaticResource ColumnLabel}" />
                      <TextBlock Grid.Column="1" Text="ACCEPTED" Style="{StaticResource ColumnLabel}"
                                 HorizontalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="ASKS FOR PASSWORD" Style="{StaticResource ColumnLabel}"
                                 HorizontalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Commands}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="0,6">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="140" />
                              </Grid.ColumnDefinitions>

                              <StackPanel Orientation="Horizontal">
                                <Path Data="{Binding IconKey, Converter={StaticResource IconKey}}"
                                      Fill="{Binding IsDestructive, Converter={StaticResource DangerIcon}}"
                                      Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Subtle}"
                                           FontWeight="Medium" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding IsDestructive, Converter={StaticResource DangerText}}" />
                              </StackPanel>

                              <Button Grid.Column="1" HorizontalAlignment="Center" BorderThickness="0"
                                      Background="Transparent" Padding="4"
                                      Command="{Binding DataContext.ToggleAcceptedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      CommandParameter="{Binding}"
                                      IsEnabled="{Binding DataContext.HasThisPc, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Accepted, Mode=OneWay}"
                                          IsHitTestVisible="False" />
                              </Button>

                              <!-- Read-only on purpose: the four destructive commands always
                                   ask, and a switch that cannot turn that off would be a lie
                                   about what it does (ADR-0011). -->
                              <CheckBox Grid.Column="2" Style="{StaticResource Switch}"
                                        IsChecked="{Binding AsksForPassword, Mode=OneWay}"
                                        IsHitTestVisible="False" IsEnabled="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding HasThisPc, Converter={StaticResource NotBoolToVis}}"
                               Text="This PC is not on the account yet, so there is nothing to accept. Add it from your phone or from Other PCs on another machine." />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <DockPanel>
                    <Button DockPanel.Dock="Top" Command="{Binding ToggleActivityCommand}"
                            BorderThickness="0" Background="Transparent" Padding="0"
                            HorizontalContentAlignment="Stretch">
                      <DockPanel>
                        <Path Data="{StaticResource Icon.History}" Fill="{StaticResource InkSoft}"
                              Width="20" Height="20" Stretch="Uniform" DockPanel.Dock="Left"
                              VerticalAlignment="Center" />
                        <Path Data="{StaticResource Icon.ExpandMore}" Fill="{StaticResource InkFaint}"
                              Width="20" Height="20" Stretch="Uniform" DockPanel.Dock="Right"
                              VerticalAlignment="Center" />
                        <StackPanel Margin="12,0,12,0">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Activity" Style="{StaticResource CardTitle}" />
                            <Border Style="{StaticResource Pill}" Background="{StaticResource Track}"
                                    Margin="8,0,0,0" Padding="7,1">
                              <TextBlock Text="{Binding ActivityCount}" Style="{StaticResource PillText}"
                                         Foreground="{StaticResource InkFaint}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                     Text="Commands this account sent, and what happened. Nothing secret is recorded." />
                        </StackPanel>
                      </DockPanel>
                    </Button>

                    <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding IsActivityOpen, Converter={StaticResource BoolToVis}}">
                      <ItemsControl ItemsSource="{Binding Activity}"
                                    ItemTemplate="{StaticResource ActivityRowTemplate}" />
                    </ScrollViewer>
                  </DockPanel>
                </Border>
              </DockPanel>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
