<Window x:Class="PCConnect.Companion.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Maximized" Topmost="True" ShowInTaskbar="False"
        FontFamily="{StaticResource Sans}"
        Title="PCConnect reminder">

  <!-- The transparent full-screen reminder.
       This is the one v3-only feature the six abandoned Wails branches were
       chasing (06 §2.1). WPF does per-pixel alpha natively, so it needs no
       framework upgrade and no borderless-window workaround. -->
  <Grid x:Name="RootGrid" Background="#8C0F172A" Opacity="0">
    <Border x:Name="Card" Width="640" VerticalAlignment="Center" HorizontalAlignment="Center"
            CornerRadius="16" Padding="40,36,40,32" Background="#0B1120"
            RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform>
        <ScaleTransform x:Name="CardScale" ScaleX="0.94" ScaleY="0.94" />
      </Border.RenderTransform>
      <Border.Effect>
        <DropShadowEffect BlurRadius="60" ShadowDepth="20" Opacity="0.45" Color="#000000" />
      </Border.Effect>

      <StackPanel>
        <DockPanel LastChildFill="False">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="EyebrowText"
                       FontFamily="{StaticResource MonoFont}" FontSize="12"
                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
            <Border x:Name="SnoozedBadge" Background="#33F59E0B" BorderBrush="#F59E0B"
                    BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0"
                    VerticalAlignment="Center" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource Icon.Schedule}" Fill="#F59E0B" Width="11" Height="11"
                      Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock x:Name="SnoozedBadgeText" Text="Snoozed for 10 mins" FontSize="11.5"
                           FontWeight="SemiBold" Foreground="#FDE68A" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
          <TextBlock x:Name="HintText" DockPanel.Dock="Right" Text="Esc to mark as completed"
                     FontSize="12.5" Opacity="0.6" />
        </DockPanel>

        <TextBlock x:Name="BodyText" FontSize="36" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="43" />

        <TextBlock x:Name="TimeText" FontSize="15" Opacity="0.7" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
          <Button x:Name="CompletedButton" Click="OnCompleted" Style="{StaticResource PrimaryButton}"
                  ToolTip="Mark this task as finished"
                  Padding="22,0" Height="44" FontSize="14.5" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource Icon.Check}" Fill="White" Width="18" Height="18"
                    Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Completed" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Snooze with clickable duration dropdown -->
          <Border x:Name="SnoozeBorder" BorderThickness="1" CornerRadius="8" Margin="0,0,12,0"
                  BorderBrush="{StaticResource Border}">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#475569" />
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SnoozeButton" Content="Snooze for" Click="OnSnoozeDefault"
                      ToolTip="Snooze reminder"
                      Padding="14,0,4,0" Height="42" FontSize="14.5" Background="Transparent"
                      BorderThickness="0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="7,0,0,7" Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#253347" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button x:Name="SnoozeDropdownButton" Click="OnSnoozeDropdownClick"
                      ToolTip="Choose snooze time"
                      Padding="4,0,12,0" Height="42" FontSize="14.5" Background="Transparent"
                      BorderThickness="0" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="0,7,7,0" Padding="{TemplateBinding Padding}">
                      <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#253347" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="SnoozeDurationText" Text="10 mins" FontWeight="SemiBold" Margin="0,0,5,0" />
                  <Path Data="{StaticResource Icon.ExpandMore}" Width="12" Height="12" Stretch="Uniform"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <Button.ContextMenu>
                  <ContextMenu x:Name="SnoozeContextMenu" Placement="Bottom"
                               Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155" BorderThickness="1">
                    <ContextMenu.Resources>
                      <Style TargetType="{x:Type MenuItem}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="#F8FAFC" />
                        <Setter Property="FontFamily" Value="{StaticResource Sans}" />
                        <Setter Property="FontSize" Value="13" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type MenuItem}">
                              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                      CornerRadius="6" Padding="{TemplateBinding Padding}"
                                      Margin="2,1">
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                  <Setter TargetName="Bd" Property="Background" Value="#334155" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                  <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                      <Style TargetType="{x:Type Separator}">
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Separator}">
                              <Rectangle Height="1" Fill="#334155" Margin="4,3" />
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ContextMenu.Resources>
                    <MenuItem Header="10 mins" Click="OnSnooze10m" FontWeight="Medium" />
                    <MenuItem Header="30 mins" Click="OnSnooze30m" FontWeight="Medium" />
                    <MenuItem Header="1 hour" Click="OnSnooze1h" FontWeight="Medium" />
                  </ContextMenu>
                </Button.ContextMenu>
              </Button>
            </StackPanel>
          </Border>

          <Button x:Name="DismissButton" Click="OnDismiss" Padding="14,4" Height="44"
                  Background="Transparent" BorderThickness="0" Opacity="0.8" Cursor="Hand"
                  ToolTip="Dismiss alert without marking as completed (leaves task incomplete and will not alert again)">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Don't remind again" FontSize="13" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Leaves task incomplete" FontSize="11" Opacity="0.65"
                               HorizontalAlignment="Center" Margin="0,1,0,0" />
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="#253347" />
                    <Setter Property="Opacity" Value="1.0" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
