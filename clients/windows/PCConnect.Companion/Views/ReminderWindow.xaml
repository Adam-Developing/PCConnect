<Window x:Class="PCConnect.Companion.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowState="Maximized" Topmost="True" ShowInTaskbar="False"
        FontFamily="{StaticResource Sans}"
        Title="PCConnect reminder">

  <!-- The transparent full-screen reminder.
       This is the one v3-only feature the six abandoned Wails branches were
       chasing (06 §2.1). WPF does per-pixel alpha natively, so it needs no
       framework upgrade and no borderless-window workaround. -->
  <Grid Background="#8C0F172A">
    <Border x:Name="Card" Width="640" VerticalAlignment="Center" HorizontalAlignment="Center"
            CornerRadius="16" Padding="40,36,40,32" Background="#0B1120">
      <Border.Effect>
        <DropShadowEffect BlurRadius="60" ShadowDepth="20" Opacity="0.45" Color="#000000" />
      </Border.Effect>

      <StackPanel>
        <DockPanel LastChildFill="False">
          <TextBlock x:Name="EyebrowText" DockPanel.Dock="Left"
                     FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Foreground="{StaticResource Accent}" />
          <TextBlock x:Name="HintText" DockPanel.Dock="Right" Text="Esc to dismiss"
                     FontSize="12.5" Opacity="0.6" />
        </DockPanel>

        <TextBlock x:Name="BodyText" FontSize="36" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,18,0,0" LineHeight="43" />

        <TextBlock x:Name="TimeText" FontSize="15" Opacity="0.7" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
          <Button x:Name="DoneButton" Click="OnDone" Style="{StaticResource PrimaryButton}"
                  Padding="22,0" Height="44" FontSize="14.5" Margin="0,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Path Data="{StaticResource Icon.Check}" Fill="White" Width="20" Height="20"
                    Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Done" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <!-- Snooze is local: the window comes back in ten minutes. The
               server has no snooze, and inventing one on the wire to make a
               button work would be the wrong way round. -->
          <Button x:Name="SnoozeButton" Content="Snooze 10 min" Click="OnSnooze"
                  Padding="22,0" Height="44" FontSize="14.5" Margin="0,0,10,0"
                  Background="Transparent" />

          <Button x:Name="DismissButton" Content="Dismiss" Click="OnDismiss" Padding="22,0" Height="44"
                  FontSize="14.5" Background="Transparent" BorderThickness="0" Opacity="0.7" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
